[Unit]
Description=Sentence Transformers API Service
After=network.target
Wants=network.target

[Service]
Type=simple
# Dedicated unprivileged user, see "Deploy (systemd)" in the README.
User=sentence-api
Group=sentence-api
WorkingDirectory=/opt/sentence-api
Environment=PATH=/opt/ai-env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=EMBEDDING_MODEL_CACHE=2
# Hugging Face model cache, in /var/cache/sentence-api (created by systemd, owned by the user).
CacheDirectory=sentence-api
Environment=HF_HOME=/var/cache/sentence-api
# Secrets (SENTENCE_TRANSFORMERS_API_KEY) and local overrides live in
# /opt/sentence-api/.env (git-ignored); the leading dash makes the file optional.
EnvironmentFile=-/opt/sentence-api/.env
ExecStart=/opt/ai-env/bin/gunicorn -c /opt/sentence-api/gunicorn.conf.py sentence-api:app
Restart=always
RestartSec=10
NoNewPrivileges=yes
# Peak about 1.9 GB with the default models and EMBEDDING_MAX_IN_FLIGHT=2
# (README, "Memory"). Raise it with EMBEDDING_MAX_IN_FLIGHT, a larger model or
# EMBEDDING_MODEL_CACHE above 1; past the limit the kernel stops the service and
# systemd restarts it.
MemoryMax=3G
# Extra sandboxing; needs mount namespaces, which an unprivileged LXC container
# may not allow (the unit then fails with status 226/NAMESPACE).
#PrivateTmp=yes
#ProtectSystem=strict
#ProtectHome=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
